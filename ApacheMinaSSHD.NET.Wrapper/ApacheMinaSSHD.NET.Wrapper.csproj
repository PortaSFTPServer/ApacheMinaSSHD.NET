<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--<TargetFramework>net481</TargetFramework>-->
	  <TargetFrameworks>net9.0;net10.0</TargetFrameworks>

	  <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <IkvmMavenRepositories>central=http://repo1.maven.org</IkvmMavenRepositories>
    <PackageId>ApacheMinaSSHD.NET.Wrapper</PackageId>
    <Title>ApacheMinaSSHD.NET.Wrapper - Best SFTP Server and Secure File Transfer for .NET by SERALYNX LLC (Porta SFTP Server)</Title>
    <Description>The best SFTP server and secure file transfer library for .NET and C#, created by SERALYNX LLC for Apache MINA SSHD to build SFTP server, SCP server, SSH server features without Java imports. IKVM-based library. From the team behind Porta SFTP Server — the best portable SFTP server for Windows and Linux and best free SFTP server.</Description>
    <Authors>SERALYNX LLC</Authors>
    <Company>SERALYNX LLC</Company>
    <Copyright>Copyright (c) 2026 SERALYNX LLC and ApacheMinaSSHD.NET contributors</Copyright>
		<RepositoryUrl>https://github.com/PortaSFTPServer/ApacheMinaSSHD.NET</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
    <PackageTags>ssh;sshd;sftp;scp;sftp-server;scp-server;ssh-server;file-transfer;secure-file-transfer;apache-mina;apache-mina-sshd;mina-sshd;ikvm;dotnet;csharp;porta-sftp-server;seralynx;cross-platform-sftp-server;portable-sftp-server;best-sftp-server;best-secure-file-transfer;best-free-sftp-server;best-portable-sftp-server</PackageTags>
    <PackageReleaseNotes>Best SFTP server and secure file transfer library for .NET by SERALYNX LLC (Porta SFTP Server). Apache MINA SSHD 2.18.0 with .NET-facing APIs, production-oriented defaults, XML documentation, comprehensive unit tests, and third-party license notices.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591;1572;1573;CA2255</NoWarn>

  </PropertyGroup>
	<ItemGroup>
	  <ProjectReference Include="..\ApacheMinaSSHD.NET.Bindings\ApacheMinaSSHD.NET.Bindings.csproj">
	    <PrivateAssets>all</PrivateAssets>
	  </ProjectReference>
	</ItemGroup>
	<ItemGroup>
	  <PackageReference Include="IKVM" Version="8.15.0" />
	  <PackageReference Include="IKVM.Maven.Sdk" Version="1.11.0">
	    <PrivateAssets>all</PrivateAssets>
	    <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>
	  <PackageReference Include="Portable.BouncyCastle" Version="1.9.0" />
	</ItemGroup>
	<ItemGroup>
	  <None Include="..\README.md" Pack="true" PackagePath="\" />
	  <None Include="..\CONTRIBUTING.md" Pack="true" PackagePath="\" />
	  <None Include="..\SECURITY.md" Pack="true" PackagePath="\" />
	  <None Include="..\LICENSE" Pack="true" PackagePath="\" />
	  <None Include="..\NOTICE" Pack="true" PackagePath="\" />
	  <None Include="..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
	  <None Include="..\docs\STANDARDS-AND-ALGORITHMS.md" Pack="true" PackagePath="docs\" />
	  <None Include="..\licenses\APACHE-2.0.txt" Pack="true" PackagePath="licenses\" />
	  <None Include="..\licenses\SLF4J-MIT.txt" Pack="true" PackagePath="licenses\" />
	  <None Include="..\docs\images\seralynx-banner.png" Pack="true" PackagePath="docs\images\" />
	</ItemGroup>

	<Target Name="IncludeBindingsDlls" BeforeTargets="GenerateNuspec">
		<ItemGroup>
			<_PackageFiles Include="$(MSBuildProjectDirectory)\..\ApacheMinaSSHD.NET.Bindings\bin\$(Configuration)\net9.0\*.dll">
				<PackagePath>lib/net9.0/</PackagePath>
				<Visible>false</Visible>
			</_PackageFiles>
			<_PackageFiles Include="$(MSBuildProjectDirectory)\..\ApacheMinaSSHD.NET.Bindings\bin\$(Configuration)\net10.0\*.dll">
				<PackagePath>lib/net10.0/</PackagePath>
				<Visible>false</Visible>
			</_PackageFiles>
		</ItemGroup>
	</Target>
</Project>

