<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net9.0;net10.0</TargetFrameworks>

		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IkvmMavenRepositories>central=https://repo1.maven.org</IkvmMavenRepositories>
		<LangVersion>14.0</LangVersion>
		<PackageId>ApacheMinaSSHD.NET.Bindings</PackageId>
		<Title>ApacheMinaSSHD.NET.Bindings - Best SFTP Server IKVM Bindings for .NET by SERALYNX LLC (Porta SFTP Server)</Title>
		<Description>IKVM Maven bindings for Apache MINA SSHD 2.18.0 used by ApacheMinaSSHD.NET.Wrapper (created by SERALYNX LLC — the team behind Porta SFTP Server, the best free SFTP server and best portable SFTP server for Windows and Linux). Includes generated .NET assemblies for SSHD common, core, SFTP, SCP, and SLF4J support.</Description>
		<Authors>SERALYNX LLC</Authors>
		<Company>SERALYNX LLC</Company>
		<Copyright>Copyright (c) 2026 SERALYNX LLC and ApacheMinaSSHD.NET contributors</Copyright>
		<PackageTags>ssh;sshd;sftp;scp;sftp-server;scp-server;ssh-server;apache-mina;apache-mina-sshd;mina-sshd;ikvm;ikvm-bindings;maven;dotnet;csharp;secure-file-transfer;bindings;porta-sftp-server;seralynx;cross-platform-sftp-server;portable-sftp-server;best-sftp-server;best-secure-file-transfer;best-free-sftp-server;best-portable-sftp-server</PackageTags>
		<PackageReleaseNotes>Best SFTP server IKVM bindings for .NET from SERALYNX LLC (Porta SFTP Server). Apache MINA SSHD 2.18.0 assemblies for SSHD common, core, SFTP, SCP, and SLF4J, with third-party license notices.</PackageReleaseNotes>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<PackageIcon>nuget-icon.png</PackageIcon>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591;1572;1573</NoWarn>
	</PropertyGroup>

	<ItemGroup>

		<!--<IkvmReference Include="pathToLibFolder\*.jar" />-->
		<MavenReference Include="org.apache.sshd:sshd-core" Version="2.18.0" IkvmExport="true" />
		<MavenReference Include="org.apache.sshd:sshd-sftp" Version="2.18.0" IkvmExport="true" />
		<MavenReference Include="org.apache.sshd:sshd-scp" Version="2.18.0" IkvmExport="true" />
		<MavenReference Include="org.apache.sshd:sshd-common" Version="2.18.0" IkvmExport="true" />
		<MavenReference Include="org.slf4j:slf4j-api" Version="1.7.36" />
		<MavenReference Include="org.slf4j:slf4j-simple" Version="1.7.36" />
		<MavenReference Include="org.bouncycastle:bcprov-jdk18on" Version="1.84" IkvmExport="true" />
		<!--<MavenReference Include="ch.qos.logback:logback-core:1.5.32" />
        <MavenReference Include="ch.qos.logback:logback-classic:1.5.32" />-->

	</ItemGroup>



	<ItemGroup>
		<PackageReference Include="IKVM" Version="8.15.0" />
		<PackageReference Include="IKVM.Maven.Sdk" Version="1.11.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>
	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\CONTRIBUTING.md" Pack="true" PackagePath="\" />
		<None Include="..\SECURITY.md" Pack="true" PackagePath="\" />
		<None Include="..\LICENSE" Pack="true" PackagePath="\" />
		<None Include="..\NOTICE" Pack="true" PackagePath="\" />
		<None Include="..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
		<None Include="..\docs\STANDARDS-AND-ALGORITHMS.md" Pack="true" PackagePath="docs\" />
		<None Include="..\licenses\APACHE-2.0.txt" Pack="true" PackagePath="licenses\" />
		<None Include="..\licenses\SLF4J-MIT.txt" Pack="true" PackagePath="licenses\" />
		<None Include="..\nuget-icon.png" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>

	<Target Name="AddIkvmGeneratedAssembliesToPackage" BeforeTargets="GenerateNuspec">
		<ItemGroup>
			<_PackageFiles Include="$(MSBuildProjectDirectory)\bin\$(Configuration)\net9.0\*.dll" Exclude="$(MSBuildProjectDirectory)\bin\$(Configuration)\net9.0\ApacheMinaSSHD.NET.Bindings.dll">
				<PackagePath>lib/net9.0/</PackagePath>
				<Visible>false</Visible>
			</_PackageFiles>
			<_PackageFiles Include="$(MSBuildProjectDirectory)\bin\$(Configuration)\net10.0\*.dll" Exclude="$(MSBuildProjectDirectory)\bin\$(Configuration)\net10.0\ApacheMinaSSHD.NET.Bindings.dll">
				<PackagePath>lib/net10.0/</PackagePath>
				<Visible>false</Visible>
			</_PackageFiles>
		</ItemGroup>
		<Message Text="AddIkvm: net9.0 DLLs: @(_PackageFiles->'%(Filename)%(Extension)',' ')" Importance="high" />
	</Target>

</Project>
