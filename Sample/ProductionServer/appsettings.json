{
  "host": "0.0.0.0",
  "port": 2222,
  "sftpRoot": "./sftp-data",
  "hostKeyPath": "./hostkey.ser",
  "auth": {
    "username": "admin",
    "password": "changeme"
  },
  "limits": {
    "maxSessions": 50,
    "maxChannels": 20,
    "idleTimeoutSeconds": 300,
    "authTimeoutSeconds": 120,
    "maxAuthRequests": 6
  },
  "algorithms": {
    "ciphers": ["aes256-gcm@openssh.com", "aes128-gcm@openssh.com", "aes256-ctr"],
    "macs": ["hmac-sha2-256-etm@openssh.com", "hmac-sha2-512-etm@openssh.com"],
    "keyExchange": ["curve25519-sha256", "ecdh-sha2-nistp256", "diffie-hellman-group16-sha512"],
    "hostKeys": ["rsa-sha2-512", "rsa-sha2-256", "ssh-ed25519"]
  },
  "banner": "Welcome to Production SFTP Server"
}
