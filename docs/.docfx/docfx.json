{
  "metadata": [
    {
      "src": [
        {
          "files": ["ApacheMinaSSHD.NET.Wrapper/ApacheMinaSSHD.NET.Wrapper.csproj"],
          "src": "../.."
        }
      ],
      "dest": "obj/api"
    }
  ],
  "build": {
    "content": [
      { "files": ["**/*.{md,yml}", "toc.yml"], "src": "obj/api", "dest": "." }
    ],
    "resource": [
      { "files": ["images/**"], "src": ".", "dest": "." },
      { "files": ["styles/**"], "src": ".", "dest": "." }
    ],
    "globalMetadata": {
      "_appTitle": "ApacheMinaSSHD.NET API Reference",
      "_appFooter": "<a href=\"https://portasftpserver.com/portable-sftp-server-community-edition/\" style=\"margin-right: 1em;\">Porta SFTP Server</a><a href=\"https://github.com/PortaSFTPServer/ApacheMinaSSHD.NET\" style=\"margin-right: 1em;\">GitHub</a><a href=\"https://portasftpserver.github.io/ApacheMinaSSHD.NET/\">ApacheMinaSSHD.NET</a>",
      "_appLogoPath": "images/logo.svg",
      "_appLogoUrl": "https://portasftpserver.github.io/ApacheMinaSSHD.NET/api/ApacheMinaSSHD.NET.Wrapper.html",
      "_enableSearch": true
    },
    "template": ["default"],
    "dest": "../api"
  }
}
