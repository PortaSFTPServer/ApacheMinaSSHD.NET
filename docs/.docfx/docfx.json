{
  "metadata": [
    {
      "src": [
        {
          "files": ["ApacheMinaSSHD.NET.Wrapper/ApacheMinaSSHD.NET.Wrapper.csproj"],
          "src": "../.."
        }
      ],
      "dest": "obj/api"
    }
  ],
  "build": {
    "content": [
      { "files": ["**/*.{md,yml}", "toc.yml"], "src": "obj/api", "dest": "." }
    ],
    "resource": [
      { "files": ["images/**"], "src": ".", "dest": "." },
      { "files": ["styles/**"], "src": ".", "dest": "." }
    ],
    "globalMetadata": {
      "_appTitle": "ApacheMinaSSHD.NET API Reference",
      "_appFooter": "",
      "_appLogoPath": "images/logo.svg",
      "_appLogoUrl": "https://portasftpserver.github.io/ApacheMinaSSHD.NET/api/ApacheMinaSSHD.NET.Wrapper.html",
      "_enableSearch": true
    },
    "template": ["default"],
    "dest": "../api"
  }
}
